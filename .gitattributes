* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
# Unified diffs use a single context-prefix space for an empty source line.
platforms/rust/patches/*.patch text eol=lf whitespace=-blank-at-eol
*.bin binary
*.png binary
*.font binary
*.ttf binary
*.hfs binary
*.rsrc binary
*.rgb binary

# Encoded terminal controls contain meaningful carriage returns.
vendor/shelly/banner_sixel.txt -text
