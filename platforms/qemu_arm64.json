{
  "name": "qemu_arm64",
  "rust_target": "aarch64-unknown-none",
  "toolchain": "rust/sdk.json",
  "install": {
    "description": "No aarch64 guest set is produced yet; this record describes the BCM2837-class machine, its SD medium and its boot path",
    "applications": [],
    "modules": []
  },
  "storage": {
    "images": {
      "sd-card": {
        "description": "SD medium: an MBR with a FAT32 boot partition holding the firmware configuration and the System payload, followed by the System RISC volume",
        "output": "sd-card.img",
        "layout": {
          "kind": "partitioned",
          "table": {
            "kind": "mbr",
            "boot": 0
          },
          "size": {
            "kind": "bytes",
            "bytes": "0x80000000"
          },
          "partitions": [
            {
              "kind": "fat32",
              "label": "BOOT",
              "size": {
                "kind": "bytes",
                "bytes": "0x10000000"
              },
              "files": [
                {
                  "source": {
                    "kind": "board-config",
                    "lines": [
                      {
                        "key": "arm_64bit",
                        "value": "1"
                      },
                      {
                        "key": "kernel",
                        "value": "kernel8.img"
                      },
                      {
                        "key": "enable_uart",
                        "value": "1"
                      },
                      {
                        "key": "uart_2ndstage",
                        "value": "1"
                      }
                    ]
                  },
                  "path": "config.txt"
                },
                {
                  "source": {
                    "kind": "artifact",
                    "artifact": "system-image"
                  },
                  "path": "kernel8.img"
                }
              ]
            },
            {
              "kind": "system7-filesystem",
              "label": "SYSTEM",
              "size": {
                "kind": "remaining"
              }
            }
          ]
        }
      }
    }
  },
  "emulation": {
    "description": "BCM2837-class SoC machine, 4x Cortex-A53, 1 GiB RAM, PL011 UART console, sdhci SD storage, bcm2835 RNG and a VideoCore mailbox framebuffer",
    "family": "qemu",
    "binary": "qemu-system-aarch64",
    "machine": "raspi3b",
    "ram": "1G",
    "harts": 4,
    "firmware": "none",
    "boot_medium": {
      "kind": "sd"
    },
    "disks": {
      "transport": "sdhci",
      "format": "raw",
      "readonly": true,
      "attach": [
        {
          "image": "sd-card",
          "boot": true
        }
      ]
    },
    "display": {
      "kind": "videocore-mailbox",
      "framebuffer": "videocore-mailbox"
    },
    "entropy": {
      "kind": "bcm2835-rng"
    },
    "network": {
      "kind": "none"
    },
    "screen": {
      "interactive": "window",
      "headless": "none"
    },
    "console": {
      "interactive": "stdio",
      "headless": "file"
    },
    "readiness": {
      "timeout_seconds": 60,
      "booted": [
        "DESKTOP_READY:",
        "BOOT_NO_SYSTEM:"
      ],
      "failed": [
        "BOOT_TRAP:",
        "BOOT_PANIC:",
        "BOOT_ALLOCATION_FAILED:",
        "SYSTEM_PANIC:",
        "SYSTEM_ALLOCATION_FAILED:",
        "SYSTEM_STARTUP_FAILED:"
      ]
    }
  },
  "hardware": {
    "description": "BCM2837-class SoC board booted from an SD card by the board's own firmware",
    "board": "bcm2837-class",
    "soc": "bcm2837",
    "boot": {
      "medium": {
        "kind": "sd"
      },
      "first_stage": "vendor-firmware"
    },
    "boot_image": "sd-card",
    "console": {
      "kind": "pl011",
      "device": "ttyAMA0",
      "baud": 115200
    },
    "device_tree": {
      "kind": "firmware"
    },
    "ram": {
      "base": "0x0",
      "bytes": "0x40000000"
    },
    "devices": [
      {
        "kind": "uart",
        "model": "pl011",
        "base": "0x3f201000",
        "bytes": "0x1000",
        "interrupt": 57
      },
      {
        "kind": "storage",
        "model": "sdhci",
        "base": "0x3f300000",
        "bytes": "0x1000",
        "interrupt": 62
      },
      {
        "kind": "gpio-mailbox",
        "model": "bcm2835-mailbox",
        "base": "0x3f00b880",
        "bytes": "0x40",
        "interrupt": 1
      },
      {
        "kind": "display",
        "model": "videocore-mailbox-framebuffer"
      },
      {
        "kind": "entropy",
        "model": "bcm2835-rng",
        "base": "0x3f104000",
        "bytes": "0x10",
        "interrupt": 61
      }
    ],
    "tooling": [
      "dd"
    ]
  }
}
