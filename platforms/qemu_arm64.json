  "emulation": {
    "description": "QEMU virt board, 4x Cortex-A72, 2 GiB RAM, virtio-MMIO devices with a virtio GPU and ramfb display",
    "family": "qemu",
    "binary": "qemu-system-riscv64",
    "machine": "virt",
    "cpu": "cortex-a72",
    "ram": "2G",
    "harts": 4,
    "firmware": "disabled",
    "boot_medium": {
      "kind": "flash",
      "unit": 0,
      "format": "raw",
      "readonly": true
