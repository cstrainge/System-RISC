{
  "name": "qemu_arm64",
  "rust_target": "aarch64-unknown-none",
  "std_target": "aarch64-unknown-systemrisc",
  "guest_linker": "platforms/linker/aarch64.ld",
  "toolchain": "rust/sdk.json",
  "llvm_profile": "neon",
  "profile_requires": [
    "neon"
  ],
  "memory": {
    "page_bytes": 4096,
    "ram_base": "0x40000000",
    "minimum_ram_bytes": "0x3f000000",
    "boot": {
      "base": "0x40080000",
      "bytes": "0xb0000"
    },
    "firmware_code_bytes": "0x33000",
    "firmware_heap": {
      "base": "0x52430000",
      "bytes": "0x1000000"
    },
    "images": {
      "base": "0x40930000",
      "bytes": "0x3000000"
    },
    "display_scratch": {
      "base": "0x50930000",
      "bytes": "0x1b00000"
    },
    "display": {
      "width": 800,
      "height": 600,
      "max_width": 1920,
      "max_height": 1200
    },
    "application_relocation_base": "0x43100000",
    "application_primary_base": "0x42000000",
    "definitions": {
      "base": "0x42100000",
      "bytes": "0x1000000"
    },
    "fdt_tail_bytes": "0x200000",
    "fw_cfg": {
      "base": "0x9020000",
      "bytes": "0x1000"
    },
    "bootstrap_io": {
      "uart": {
        "base": "0x9000000",
        "bytes": "0x1000",
        "kind": "pl011"
      },
      "virtio_mmio": {
        "base": "0xa000000",
        "stride": "0x200",
        "slots": 32,
        "interrupt_base": 1
      },
      "interrupt_controller": {
        "base": "0x8000000",
        "bytes": "0x20000"
      }
    },
    "boot_stack_bytes": "0x40000",
    "monitor_stack_bytes": "0x1000",
    "system_heap_bytes": "0x20000000",
    "system_recovery_bytes": "0x2000000",
    "stacks": {
      "system": {
        "minimum": "0x40000",
        "default": "0x400000",
        "maximum": "0x800000"
      },
      "application": {
        "minimum": "0x10000",
        "default": "0x400000",
        "maximum": "0x800000"
      }
    },
    "application_heap": {
      "minimum_extent_bytes": "0x10000"
    },
    "tls": {
      "key_capacity": 256
    },
    "process_accounts": {
      "kernel_bytes": "0x1000000",
      "application_bytes": "0x4000000"
    },
    "module_accounts": {
      "kernel_bytes": "0x1000000",
      "worker_stack_bytes": "0x400000"
    }
  },
  "virtual_memory": {
    "mode": "aarch64",
    "application": {
      "start": "0x0000000000400000",
      "end": "0x0000002000000000"
    },
    "process_kernel": {
      "start": "0xffffffc000000000",
      "end": "0xffffffc800000000"
    },
    "modules": {
      "start": "0xffffffc800000000",
      "end": "0xffffffd000000000"
    },
    "system": {
      "start": "0xffffffd000000000",
      "end": "0xfffffffffffff000"
    },
    "physmap": {
      "start": "0xffffffe000000000",
      "end": "0xfffffff000000000"
    },
    "application_image_base": "0x0000000000400000",
    "system_image_base": "0xffffffd000200000",
    "system_heap_base": "0xffffffd040000000",
    "system_stacks": {
      "start": "0xffffffd010000000",
      "end": "0xffffffd020000000"
    },
    "physmap_physical_base": "0x40000000"
  },
  "scheduling": {
    "maximum_active_harts": 1,
    "quantum_microseconds": 250,
    "callback_budget_microseconds": 1000
  },
  "bootloader": {
    "description": "EL1 bootloader: installs the 39-bit translation regime, finds the boot volume over virtio-MMIO, loads the resident System, and drops to EL1",
    "package": "bootrom-aarch64-virt",
    "artifact": "bootrom-aarch64-virt",
    "entry": "bootrom-aarch64-virt/src/entry.S"
  },
  "hardware": {
    "description": "QEMU virt machine, 4x Cortex-A72, 2 GiB RAM at 0x40000000. The machine supplies its own device tree and the bootloader reads the pointer it passes in x0, so this section is a declaration to be checked against that tree rather than the runtime source. Nothing is generated for this platform.",
    "boot": {
      "medium": {
        "kind": "none"
      },
      "first_stage": "none"
    },
    "devices": [
      {
        "kind": "uart",
        "model": "pl011",
        "base": "0x9000000",
        "bytes": "0x1000",
        "interrupt": 33
      },
      {
        "kind": "storage",
        "model": "virtio,mmio",
        "base": "0xa000000",
        "bytes": "0x4000",
        "interrupt": 48
      }
    ],
    "board": "qemu-virt",
    "console": {
      "kind": "pl011",
      "compatible": "arm,pl011"
    }
  },
  "emulation": {
    "description": "QEMU virt board, 4x Cortex-A72, 2 GiB RAM at 0x40000000, virtio-MMIO devices with a virtio GPU and ramfb display",
    "family": "qemu",
    "binary": "qemu-system-aarch64",
    "machine": "virt",
    "cpu": "cortex-a72",
    "ram": "2G",
    "harts": 4,
    "firmware": "disabled",
    "boot_medium": {
      "kind": "direct"
    },
    "disks": {
      "transport": "virtio-mmio",
      "format": "raw",
      "readonly": true,
      "slots": [
        0,
        3,
        4,
        7
      ],
      "attach": [
        {
          "image": "system-disk",
          "slot": 0,
          "boot": true
        }
      ]
    },
    "display": {
      "kind": "virtio-gpu",
      "framebuffer": "ramfb",
      "transport": {
        "kind": "virtio-mmio",
        "slot": 6
      }
    },
    "keyboard": {
      "kind": "virtio-keyboard",
      "transport": {
        "kind": "virtio-mmio",
        "slot": 1
      }
    },
    "pointer": {
      "kind": "tablet",
      "transport": {
        "kind": "virtio-mmio",
        "slot": 2
      }
    },
    "entropy": {
      "kind": "virtio-rng",
      "transport": {
        "kind": "virtio-mmio",
        "slot": 5
      }
    },
    "network": {
      "kind": "none"
    },
    "screen": {
      "interactive": "window",
      "headless": "none"
    },
    "console": {
      "interactive": "stdio",
      "headless": "file"
    },
    "readiness": {
      "timeout_seconds": 60,
      "booted": [
        "DESKTOP_READY:",
        "BOOT_NO_SYSTEM:"
      ],
      "failed": [
        "BOOT_TRAP:",
        "BOOT_PANIC:",
        "BOOT_ALLOCATION_FAILED:",
        "SYSTEM_PANIC:",
        "SYSTEM_ALLOCATION_FAILED:",
        "SYSTEM_STARTUP_FAILED:",
        "BOOT_AARCH64_DT_REFUSED:",
        "BOOT_AARCH64_CONSOLE_MISMATCH:",
        "BOOT_AARCH64_COUNTER_REFUSED:",
        "BOOT_AARCH64_NO_DISK:",
        "BOOT_AARCH64_SYSTEM_REFUSED:",
        "BOOT_AARCH64_MOUNT_FAILED:"
      ]
    }
  },
  "storage": {
    "images": {
      "system-disk": {
        "description": "Bare HFS-B System RISC volume over the whole 500 MiB medium, with no partition table, which is what the resident disk driver expects",
        "output": "system7.hfsb",
        "layout": {
          "kind": "filesystem",
          "filesystem": "system7",
          "size": {
            "kind": "bytes",
            "bytes": "0x1f400000"
          }
        }
      }
    }
  },
  "install": {
    "description": "The aarch64 System set: the resident kernel and the drivers for the video and entropy devices this record attaches, the startup Finder, and the applications the public SDK builds for this architecture",
    "set": "packages",
    "applications": [
      "mac-finder",
      "quickdraw-test",
      "text-edit",
      "cursor-test",
      "panic-test",
      "resedit",
      "reactor",
      "control-suite",
      "mac-terminal",
      "shelly-shell",
      "mac-echo"
    ],
    "modules": [
      "mac-system",
      "virtio-gpu",
      "virtio-rng",
      "psci-power"
    ],
    "folders": {
      "applications": "Applications",
      "system": "System Folder",
      "drivers": "System Folder/Drivers",
      "extensions": "System Folder/Extensions"
    },
    "exceptions": {
      "mac-finder": "System Folder",
      "mac-terminal": "Applications/Utility",
      "shelly-shell": "Applications/Utility/Cli",
      "mac-echo": "Applications/Utility/Cli"
    }
  }
}
