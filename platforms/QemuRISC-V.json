{
  "include": "RiscVBase.json",
  "name": "QemuRISC-V",
  "emulation": {
    "description": "QEMU virt board, 4 RVA23 harts, 2 GiB RAM, virtio-MMIO devices with a virtio GPU and ramfb display",
    "family": "qemu",
    "binary": "qemu-system-riscv64",
    "machine": "virt",
    "cpu": "rva23s64,mmu=on,pmp=on,sv39=on",
    "ram": "2G",
    "harts": 4,
    "firmware": "none",
    "boot_medium": { "kind": "flash", "unit": 0, "format": "raw", "readonly": true },
    "disks": {
      "transport": "virtio-mmio",
      "format": "raw",
      "readonly": true,
      "slots": [0, 3, 4, 7]
    },
    "display": {
      "kind": "virtio-gpu",
      "framebuffer": "ramfb",
      "transport": { "kind": "virtio-mmio", "slot": 6 }
    },
    "keyboard": {
      "kind": "virtio-keyboard",
      "transport": { "kind": "virtio-mmio", "slot": 1 }
    },
    "pointer": {
      "kind": "tablet",
      "transport": { "kind": "virtio-mmio", "slot": 2 }
    },
    "entropy": {
      "kind": "virtio-rng",
      "transport": { "kind": "virtio-mmio", "slot": 5 }
    },
    "network": { "kind": "none" },
    "screen": { "interactive": "window", "headless": "none" },
    "console": { "interactive": "stdio", "headless": "file" },
    "readiness": {
      "timeout_seconds": 15,
      "booted": ["DESKTOP_READY:", "BOOT_NO_SYSTEM:"],
      "failed": [
        "BOOT_TRAP:",
        "BOOT_PANIC:",
        "BOOT_ALLOCATION_FAILED:",
        "SYSTEM_PANIC:",
        "SYSTEM_ALLOCATION_FAILED:",
        "SYSTEM_STARTUP_FAILED:"
      ]
    }
  }
}
