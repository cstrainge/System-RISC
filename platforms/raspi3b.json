  "bootloader": {
    "description": "AArch64 boot ROM that the board's own VideoCore firmware loads from the FAT32 boot partition into RAM at 0x80000 and starts at EL2 with the MMU off; it installs the 39-bit translation regime and reads the System volume from the SD card",
    "package": "bootrom-aarch64",
    "artifact": "bootrom-aarch64",
    "entry": "bootrom-aarch64/src/entry.S",
    "linker_script": "bootrom-aarch64/link.ld"
  },
  "storage": {
    "images": {
      "sd-card": {
        "description": "SD medium: an MBR with a FAT32 boot partition holding the firmware configuration and the System payload, followed by the System RISC volume",
        "output": "sd-card.img",
        "layout": {
          "kind": "partitioned",
          "table": {
            "kind": "mbr",
            "boot": 0
          },
          "size": {
            "kind": "bytes",
            "bytes": "0x80000000"
          },
          "partitions": [
            {
              "kind": "fat32",
              "label": "BOOT",
              "size": {
                "kind": "bytes",
                "bytes": "0x10000000"
              },
              "files": [
                {
                  "source": {
                    "kind": "board-config",
                    "lines": [
                      {
                        "key": "arm_64bit",
                        "value": "1"
                      },
                      {
                        "key": "kernel",
                        "value": "kernel8.img"
                      },
                      {
                        "key": "enable_uart",
                        "value": "1"
                      },
                      {
                        "key": "uart_2ndstage",
                        "value": "1"
                      }
                    ]
                  },
                  "path": "config.txt"
                },
                {
                  "source": {
                    "kind": "artifact",
                    "artifact": "bootrom-aarch64"
                  },
                  "path": "kernel8.img"
                }
              ]
            },
            {
              "kind": "system7-filesystem",
              "label": "SYSTEM",
              "size": {
                "kind": "remaining"
              }
            }
          ]
        }
      }
    }
  },
  "emulation": {
    "description": "BCM2837-class SoC machine, 4x Cortex-A53, 1 GiB RAM, PL011 UART console, sdhci SD storage, bcm2835 RNG and a VideoCore mailbox framebuffer",
    "family": "qemu",
    "binary": "qemu-system-aarch64",
    "machine": "raspi3b",
    "ram": "1G",
    "harts": 4,
    "firmware": "none",
    "boot_medium": {
      "kind": "sd"
    },
    "disks": {
      "transport": "sdhci",
      "format": "raw",
      "readonly": false,
      "attach": [
        {
          "image": "sd-card",
          "boot": true
        }
      ]
    },
    "display": {
      "kind": "videocore-mailbox",
      "framebuffer": "videocore-mailbox"
    },
    "entropy": {
      "kind": "bcm2835-rng"
    },
    "network": {
      "kind": "none"
    },
    "screen": {
      "interactive": "window",
      "headless": "none"
    },
    "console": {
      "interactive": "stdio",
      "headless": "file"
    },
    "readiness": {
      "timeout_seconds": 60,
      "booted": [
        "DESKTOP_READY:",
        "BOOT_NO_SYSTEM:"
      ],
      "failed": [
        "BOOT_TRAP:",
        "BOOT_PANIC:",
        "BOOT_ALLOCATION_FAILED:",
        "SYSTEM_PANIC:",
        "SYSTEM_ALLOCATION_FAILED:",
        "SYSTEM_STARTUP_FAILED:"
      ]
    }
  },
  "hardware": {
    "description": "BCM2837-class SoC board booted from an SD card by the board's own firmware. Its DMA controller has fifteen channels, of which the board's own firmware keeps four for itself: the reference hardware description gives the ARM channels 0, 2, 4, 5 and 8 through 14, and that mask is what a driver must take its channels from rather than assuming all fifteen. The controller is therefore shared: the SD host path is served by channel 13 when that controller is driven, and a timed output needs a channel of its own from the same set.",
    "board": "bcm2837-class",
    "soc": "bcm2837",
    "boot": {
      "medium": {
        "kind": "sd"
      },
      "first_stage": "vendor-firmware"
    },
    "boot_image": "sd-card",
    "console": {
      "kind": "pl011",
      "device": "ttyAMA0",
      "baud": 115200
    },
    "device_tree": {
      "kind": "generated"
    },
    "ram": {
      "base": "0x0",
      "bytes": "0x40000000"
    },
    "devices": [
      {
        "kind": "uart",
        "model": "pl011",
        "base": "0x3f201000",
        "bytes": "0x1000",
        "interrupt": 57
      },
      {
        "kind": "storage",
        "model": "sdhci",
        "base": "0x3f300000",
        "bytes": "0x1000",
        "interrupt": 62
      },
      {
        "kind": "gpio-mailbox",
        "model": "bcm2835-mailbox",
        "base": "0x3f00b880",
        "bytes": "0x40",
        "interrupt": 1
      },
      {
        "kind": "display",
        "model": "videocore-mailbox-framebuffer"
      },
      {
        "kind": "entropy",
        "model": "bcm2835-rng",
        "base": "0x3f104000",
        "bytes": "0x10",
        "interrupt": 61
      },
      {
        "kind": "dma",
        "model": "bcm2835-dma",
        "base": "0x3f007000",
        "bytes": "0xf00",
        "interrupt": 16
      },
      {
        "kind": "spi",
        "model": "bcm2835-spi0",
        "base": "0x3f204000",
        "bytes": "0x200",
        "interrupt": 54
      },
      {
        "kind": "auxiliary",
        "model": "bcm2835-aux",
        "base": "0x3f215000",
        "bytes": "0x1000",
        "interrupt": 29
      },
      {
        "kind": "pwm",
        "model": "bcm2835-pwm",
        "base": "0x3f20c000",
        "bytes": "0x28"
      },
      {
        "kind": "audio",
        "model": "bcm2835-i2s",
        "base": "0x3f203000",
        "bytes": "0x24"
      },
      {
        "kind": "clock",
        "model": "bcm2835-cprman",
        "base": "0x3f101000",
        "bytes": "0x2000"
      }
    ],
    "tooling": [
      "cargo xtask flash"
    ],
    "unused": [
      {
        "model": "bcm2835-sdhost",
        "base": "0x3f202000",
        "reason": "This SoC carries two SD controllers and the platform drives the Arasan sdhci at 0x3f300000: a self-test binary on the board read the user's card, including its partition table, through that block. Some public descriptions of this family attach the microSD slot to bcm2835-sdhost instead; that does not hold for this board, and the board is the authority. Nothing drives bcm2835-sdhost, so it has no mmio_devices window: a window granted to no module is a claim nobody can use."
      }
    ]
  }
}
