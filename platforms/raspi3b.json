{
  "name": "raspi3b",
  "rust_target": "aarch64-unknown-none",
  "std_target": "aarch64-unknown-systemrisc",
  "toolchain": "rust/sdk.json",
  "guest_linker": "platforms/linker/aarch64.ld",
  "llvm_profile": "neon",
  "profile_requires": [
    "neon"
  ],
  "install": {
    "description": "The aarch64 System set for the board: the resident kernel, the VideoCore mailbox framebuffer driver that owns the display, the startup Finder, and the applications that build for this architecture. The board has no virtio bus, so nothing that expects one is installed.",
    "set": "packages",
    "applications": [
      "mac-finder",
      "quickdraw-test",
      "text-edit",
      "cursor-test",
      "panic-test",
      "resedit",
      "reactor",
      "control-suite"
    ],
    "modules": [
      "mac-system",
      "videocore-framebuffer"
    ],
    "folders": {
      "applications": "Applications",
      "system": "System Folder",
      "drivers": "System Folder/Drivers",
      "extensions": "System Folder/Extensions"
    },
    "exceptions": {
      "mac-finder": "System Folder"
    }
  },
  "memory": {
    "page_bytes": 4096,
    "ram_base": "0x0",
    "minimum_ram_bytes": "0x3f000000",
