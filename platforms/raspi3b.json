  "bootloader": {
    "description": "AArch64 boot ROM that the board's own VideoCore firmware loads from the FAT32 boot partition into RAM at 0x80000 and starts at EL2 with the MMU off; it installs the 39-bit translation regime and reads the System volume from the SD card",
    "package": "bootrom-aarch64",
    "artifact": "bootrom-aarch64",
    "entry": "bootrom-aarch64/src/entry.S",
    "linker_script": "bootrom-aarch64/link.ld"
  },
  "storage": {
    "images": {
      "sd-card": {
        "description": "SD medium: an MBR with a FAT32 boot partition holding the firmware configuration and the System payload, followed by the System RISC volume",
        "output": "sd-card.img",
        "layout": {
          "kind": "partitioned",
          "table": {
            "kind": "mbr",
            "boot": 0
          },
          "size": {
            "kind": "bytes",
            "bytes": "0x1f400000"
          },
          "partitions": [
