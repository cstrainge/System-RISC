{
  "include": "riscv_base.json",
  "name": "qemu_riscv",
  "guest_linker": "platforms/linker/riscv64.ld",
  "install": {
    "description": "The complete System RISC desktop: every application, resident driver and System extension this platform ships",
    "applications": [
      "mac-finder",
      "quickdraw-test",
      "text-edit",
      "cursor-test",
      "panic-test",
      "resedit",
      "reactor",
      "control-suite",
      "mac-terminal",
      "shelly-shell",
      "mac-echo",
      "mac-ls"
    ],
    "modules": [
      "mac-system",
      "vhost-transport",
      "vdagent-channel",
      "virtio-rng",
      "virtio-gpu",
      "host-clipboard-extension",
      "cli-extension",
      "multi-scheduler-extension",
      "vhost-filesystem",
      "stuffit-filesystem",
      "sifive-test-power"
    ],
    "folders": {
      "applications": "Applications",
      "system": "System Folder",
      "drivers": "System Folder/Drivers",
      "extensions": "System Folder/Extensions"
    },
    "exceptions": {
      "mac-finder": "System Folder",
      "mac-terminal": "Applications/Utility",
      "shelly-shell": "Applications/Utility/Cli",
      "mac-echo": "Applications/Utility/Cli",
      "mac-ls": "Applications/Utility/Cli"
    }
  },
  "bootloader": {
    "description": "M-mode boot ROM: executes in place from read-only pflash, probes the machine and loads the resident System from the boot disk",
    "package": "bootrom-riscv",
    "artifact": "bootrom-riscv",
    "entry": "platforms/riscv64-entry.S",
    "linker_script": "bootrom-riscv/link.ld",
    "page_table": "mac-riscv-pages"
  },
  "storage": {
    "images": {
      "system-disk": {
        "description": "Bare HFS-B System RISC volume over the whole 500 MiB medium, with no partition table, which is what the resident disk driver expects",
        "output": "system7.hfsb",
        "layout": {
          "kind": "filesystem",
          "filesystem": "system7",
          "size": {
            "kind": "bytes",
            "bytes": "0x1f400000"
          }
        }
      }
    }
  },
  "emulation": {
    "description": "QEMU virt board, 4 RVA23 harts, 2 GiB RAM, virtio-MMIO devices with a virtio GPU and ramfb display",
    "family": "qemu",
    "binary": "qemu-system-riscv64",
    "machine": "virt",
    "cpu": "rva23s64,mmu=on,pmp=on,sv39=on",
    "ram": "2G",
    "harts": 4,
    "firmware": "disabled",
    "boot_medium": {
      "kind": "flash",
      "unit": 0,
      "format": "raw",
      "readonly": true
    },
    "disks": {
      "transport": "virtio-mmio",
      "format": "raw",
      "readonly": true,
      "slots": [
        0,
        7
      ],
      "attach": [
        {
          "image": "system-disk",
          "slot": 0,
          "boot": true
        }
      ]
    },
    "display": {
      "kind": "virtio-gpu",
      "framebuffer": "ramfb",
      "transport": {
        "kind": "virtio-mmio",
        "slot": 6
      }
    },
    "keyboard": {
      "kind": "virtio-keyboard",
      "transport": {
        "kind": "virtio-mmio",
        "slot": 1
      }
    },
    "pointer": {
      "kind": "tablet",
      "transport": {
        "kind": "virtio-mmio",
        "slot": 2
      }
    },
    "entropy": {
      "kind": "virtio-rng",
      "transport": {
        "kind": "virtio-mmio",
        "slot": 5
      }
    },
    "network": {
      "kind": "none"
    },
    "clipboard": {
      "transport": {
        "kind": "virtio-mmio",
        "slot": 4
      }
    },
    "host_folders": {
      "transport": {
        "kind": "virtio-mmio",
        "slot": 3
      }
    },
    "screen": {
      "interactive": "window",
      "headless": "none"
    },
    "console": {
      "interactive": "stdio",
      "headless": "file"
    },
    "readiness": {
      "timeout_seconds": 60,
      "booted": [
        "DESKTOP_READY:",
        "BOOT_NO_SYSTEM:"
      ],
      "failed": [
        "BOOT_TRAP:",
        "BOOT_PANIC:",
        "BOOT_ALLOCATION_FAILED:",
        "SYSTEM_PANIC:",
        "SYSTEM_ALLOCATION_FAILED:",
        "SYSTEM_STARTUP_FAILED:"
      ]
    }
  }
}
